@startuml
hide methods
entity "Партия сырья" as RawLot {
  * id <<PK>>
  --
  поставщик
  сорт
  дата_поступления
}
entity "Партия" as Batch {
  * id <<PK>>
  --
  код
  дата
  статус
  * raw_material_lot_id <<FK>>
  * specification_id <<FK>>
}
entity "Параметр" as Parameter {
  * id <<PK>>
  --
  наименование
  единица
}
entity "Спецификация" as Specification {
  * id <<PK>>
  --
  версия
  действует_с
}
entity "Норматив" as Limit {
  * id <<PK>>
  --
  * specification_id <<FK>>
  * parameter_id <<FK>>
  минимум
  максимум
}
entity "Измерение" as Measurement {
  * id <<PK>>
  --
  * batch_id <<FK>>
  * parameter_id <<FK>>
  * operator_id <<FK>>
  значение
  время
}
entity "Сотрудник" as Operator {
  * id <<PK>>
  --
  ФИО
  роль
}
entity "Отклонение" as Deviation {
  * id <<PK>>
  --
  * measurement_id <<FK>>
  причина
  серьёзность
  статус
}
RawLot ||--o{ Batch
Specification ||--o{ Batch : назначена
Specification ||--|{ Limit
Parameter ||--o{ Limit
Batch ||--o{ Measurement
Parameter ||--o{ Measurement
Operator ||--o{ Measurement
Measurement ||--o| Deviation
' Связь M:N «Партия — Параметр» разрешена через Measurement.
@enduml
