<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_bpmn.bpmn" targetNamespace="https://mirea.example/potato-control">
  <bpmn:collaboration id="Collab_bpmn.bpmn">
    <bpmn:participant id="Participant_Plant" name="Контроль производственной партии сухого картофельного пюре — AS-IS" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="Контроль производственной партии сухого картофельного пюре — AS-IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Operator" name="Оператор линии">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateBatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Heat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lab" name="Лаборант">
        <bpmn:flowNodeRef>InputControl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RawOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OutputControl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RepeatControl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tech" name="Технолог">
        <bpmn:flowNodeRef>SelectSpec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasDeviation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Поступила партия сырья" />
    <bpmn:userTask id="CreateBatch" name="Создать карточку партии" />
    <bpmn:manualTask id="InputControl" name="Выполнить входной контроль сырья" />
    <bpmn:exclusiveGateway id="RawOK" name="Сырьё соответствует?" />
    <bpmn:endEvent id="Reject" name="Партия сырья отклонена" />
    <bpmn:userTask id="SelectSpec" name="Назначить технологическую спецификацию" />
    <bpmn:manualTask id="Prep" name="Зарегистрировать подготовительные операции" />
    <bpmn:manualTask id="Heat" name="Зарегистрировать тепловую обработку" />
    <bpmn:manualTask id="Dry" name="Зарегистрировать параметры сушки" />
    <bpmn:manualTask id="OutputControl" name="Выполнить выходной контроль" />
    <bpmn:userTask id="Validate" name="Проверить измерения по нормативам">
      <bpmn:documentation>Будущая автоматизируемая операция; в модели AS-IS выполняется сотрудником вручную.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="HasDeviation" name="Есть отклонения?" />
    <bpmn:userTask id="Correct" name="Зарегистрировать корректирующее действие" />
    <bpmn:manualTask id="RepeatControl" name="Выполнить повторное измерение" />
    <bpmn:userTask id="Assess" name="Сопоставить параметры со спецификациями">
      <bpmn:documentation>Будущая автоматизируемая операция; в модели AS-IS выполняется сотрудником вручную.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Form" name="Сформировать электронный протокол партии">
      <bpmn:documentation>Будущая автоматизируемая операция; в модели AS-IS выполняется сотрудником вручную.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Approve" name="Утвердить результат контроля" />
    <bpmn:endEvent id="End" name="Протокол утверждён" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="CreateBatch" />
    <bpmn:sequenceFlow id="F2" sourceRef="CreateBatch" targetRef="InputControl" />
    <bpmn:sequenceFlow id="F3" sourceRef="InputControl" targetRef="RawOK" />
    <bpmn:sequenceFlow id="F4" sourceRef="RawOK" targetRef="Reject" name="Нет" />
    <bpmn:sequenceFlow id="F5" sourceRef="RawOK" targetRef="SelectSpec" name="Да" />
    <bpmn:sequenceFlow id="F6" sourceRef="SelectSpec" targetRef="Prep" />
    <bpmn:sequenceFlow id="F7" sourceRef="Prep" targetRef="Heat" />
    <bpmn:sequenceFlow id="F8" sourceRef="Heat" targetRef="Dry" />
    <bpmn:sequenceFlow id="F9" sourceRef="Dry" targetRef="OutputControl" />
    <bpmn:sequenceFlow id="F10" sourceRef="OutputControl" targetRef="Validate" />
    <bpmn:sequenceFlow id="F11" sourceRef="Validate" targetRef="HasDeviation" />
    <bpmn:sequenceFlow id="F12" sourceRef="HasDeviation" targetRef="Correct" name="Да" />
    <bpmn:sequenceFlow id="F13" sourceRef="Correct" targetRef="RepeatControl" />
    <bpmn:sequenceFlow id="F14" sourceRef="RepeatControl" targetRef="Validate" />
    <bpmn:sequenceFlow id="F15" sourceRef="HasDeviation" targetRef="Assess" name="Нет" />
    <bpmn:sequenceFlow id="F16" sourceRef="Assess" targetRef="Form" />
    <bpmn:sequenceFlow id="F17" sourceRef="Form" targetRef="Approve" />
    <bpmn:sequenceFlow id="F18" sourceRef="Approve" targetRef="End" />
    <bpmn:dataObject id="Object_DataRaw" name="Данные партии сырья" />
    <bpmn:dataObjectReference id="DataRaw" name="Данные партии сырья" dataObjectRef="Object_DataRaw" />
    <bpmn:dataObject id="Object_DataSpec" name="Спецификация" />
    <bpmn:dataObjectReference id="DataSpec" name="Спецификация" dataObjectRef="Object_DataSpec" />
    <bpmn:dataObject id="Object_DataMeasurements" name="Журнал измерений" />
    <bpmn:dataObjectReference id="DataMeasurements" name="Журнал измерений" dataObjectRef="Object_DataMeasurements" />
    <bpmn:dataObject id="Object_DataDeviation" name="Журнал отклонений" />
    <bpmn:dataObjectReference id="DataDeviation" name="Журнал отклонений" dataObjectRef="Object_DataDeviation" />
    <bpmn:dataObject id="Object_DataProtocol" name="Протокол партии" />
    <bpmn:dataObjectReference id="DataProtocol" name="Протокол партии" dataObjectRef="Object_DataProtocol" />
    <bpmn:association id="A1" sourceRef="DataRaw" targetRef="InputControl" />
    <bpmn:association id="A2" sourceRef="DataSpec" targetRef="SelectSpec" />
    <bpmn:association id="A3" sourceRef="DataMeasurements" targetRef="OutputControl" />
    <bpmn:association id="A4" sourceRef="DataDeviation" targetRef="Correct" />
    <bpmn:association id="A5" sourceRef="Form" targetRef="DataProtocol" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bpmn.bpmn">
    <bpmndi:BPMNPlane id="BPMNPlane_bpmn.bpmn" bpmnElement="Collab_bpmn.bpmn">
